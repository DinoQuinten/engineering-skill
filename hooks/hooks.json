{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only response-discipline",
            "statusMessage": "Loading response-discipline..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only engineering-discipline",
            "statusMessage": "Loading engineering-discipline..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only task-registry",
            "statusMessage": "Loading task-registry..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only planning-discipline",
            "statusMessage": "Loading planning-discipline when in plan mode..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only response-discipline",
            "statusMessage": "Loading response-discipline for subagent..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only engineering-discipline",
            "statusMessage": "Loading engineering-discipline for subagent..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only task-registry",
            "statusMessage": "Loading task-registry for subagent..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only planning-discipline",
            "statusMessage": "Loading planning-discipline for plan-mode subagent..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only planning-discipline",
            "statusMessage": "Loading planning-discipline when in plan mode..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterPlanMode|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-skills.mjs\" --only planning-discipline",
            "statusMessage": "Syncing planning-discipline with plan mode..."
          }
        ]
      }
    ]
  }
}
